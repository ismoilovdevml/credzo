# Copy to .env and adjust. Never commit the real .env.

# REQUIRED. 32-byte master key (base64) used to encrypt every stored secret
# with AES-256-GCM. Generate with:
#   openssl rand -base64 32
# Back it up somewhere safe: if it is lost, stored credentials cannot be decrypted.
CREDZO_ENCRYPTION_KEY=

# Directory holding the SQLite database (credzo.db). Defaults to ./data
# locally and /app/data in the Docker image.
DATA_DIR=./data

# Session cookies are marked Secure in production by default. Set to "false"
# only when serving over plain HTTP on a trusted network (no TLS proxy).
COOKIE_SECURE=

# Number of reverse proxies in front of Credzo that append to X-Forwarded-For
# (nginx, Traefik, Caddy, a load balancer). Set to 1 behind a single proxy.
# Leave at 0 when Credzo is exposed directly: the header is then ignored for
# rate limiting, because clients could forge it.
TRUST_PROXY=0

# Port the server listens on (docker compose maps this host port to the container).
PORT=3000
